# Copy to .env and fill in. NEVER commit .env.

# PostgreSQL connection string
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/codecrest

# Public base URL of the site (used for payment callbacks, sitemap, same-origin checks)
APP_URL=http://localhost:3002

# Long random string (>= 32 chars). Generate: openssl rand -base64 48. (Reserved: sessions currently use random hashed server-side tokens.)
SESSION_SECRET=change-me-to-a-long-random-string

# First administrator, consumed ONLY by `npm run admin:create`. Choose a strong password.
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Store Administrator
ADMIN_PASSWORD=

# Paystack (leave empty until your Paystack business account is approved)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Email via Resend (leave empty until a sending domain is verified)
RESEND_API_KEY=
EMAIL_FROM=

# Optional: where uploaded product images are stored (default ./storage/uploads)
UPLOAD_DIR=

# Number of trusted reverse proxies in front of the app (used to read the real client IP from X-Forwarded-For). 1 = Railway/Vercel-style single proxy.
TRUSTED_PROXY_HOPS=1
